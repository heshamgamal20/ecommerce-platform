APP_NAME=EcommercePlatform
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shop.example.com
API_RATE_LIMIT_PER_MINUTE=120

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Use managed PostgreSQL or MySQL in production. Never use SQLite for the live store.
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=
REDIS_PASSWORD=
REDIS_PORT=6379

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Set provider credentials through the deployment secret manager, not this file.
PAYMOB_ENABLED=false
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_NOTIFICATION_URL=https://shop.example.com/api/v1/webhooks/paymob
PAYMOB_TIMEOUT=15

KASHIER_ENABLED=false
KASHIER_API_BASE_URL=https://api.kashier.io
KASHIER_MERCHANT_ID=
KASHIER_SECRET_KEY=
KASHIER_PAYMENT_API_KEY=
KASHIER_WEBHOOK_URL=https://shop.example.com/api/v1/webhooks/kashier
KASHIER_TIMEOUT=15

BOSTA_ENABLED=false
BOSTA_BASE_URL=https://app.bosta.co
BOSTA_API_KEY=
BOSTA_WEBHOOK_URL=https://shop.example.com/api/v1/webhooks/bosta
BOSTA_WEBHOOK_AUTH_HEADER=Authorization
BOSTA_WEBHOOK_AUTH_VALUE=
BOSTA_TIMEOUT=15

CORS_ALLOWED_ORIGINS=https://shop.example.com
BACKUP_ENABLED=true
BACKUP_SCHEDULE=02:00
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=/var/backups/ecommerce-platform
